// TaiwanAgri.Worker 設定範本。複製成 appsettings.Development.json（或用 User Secrets）後填入實際值。
// appsettings.json 與 appsettings.*.json 都不進版控，本檔是唯一有版控的設定形狀來源。
// .NET 的 JSON 設定讀取器允許註解，複製後可以原樣保留。
{
  "ConnectionStrings": {
    // 與 Web 指向同一個資料庫；Worker 不需要 Redis
    "DefaultConnection": "Server=localhost,1433;Database=TaiwanAgriPlatform;User Id=sa;Password=<你的密碼>;TrustServerCertificate=True"
  },

  "RabbitMQ": {
    "HostName": "localhost"
  },

  // 以下四區都有程式碼內建預設值，這裡列的就是預設值，要調整才寫進來。
  // 農業部端點對大批次查詢的回應時間差距很大，所以逾時是逐支 Worker 設定而非全域一個值
  "AgriProductsSyncWorker": {
    "HttpTimeoutSeconds": 90
  },
  "AnimalRecognitionSyncWorker": {
    "LegacyFetchTimeoutSeconds": 300
  },
  "LegalSpecificPetSyncWorker": {
    "LegacyFetchTimeoutSeconds": 300
  },
  "PetLoseListSyncWorker": {
    // 協尋貼文按日期分批抓，一批幾天
    "BatchSizeInDays": 5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "File": {
    "Path": "logs/worker-.log",
    "RollingInterval": "Day"
  }
}
