// TaiwanAgri.Web 設定範本。複製成 appsettings.Development.json（或用 User Secrets）後填入實際值。
// appsettings.json 與 appsettings.*.json 都不進版控，本檔是唯一有版控的設定形狀來源。
// .NET 的 JSON 設定讀取器允許註解，複製後可以原樣保留。
{
  "ConnectionStrings": {
    // docker-compose 起的 SQL Server 與 Redis；密碼同 .env 的 SA_PASSWORD
    "DefaultConnection": "Server=localhost,1433;Database=TaiwanAgriPlatform;User Id=sa;Password=<你的密碼>;TrustServerCertificate=True",

    // Redis 是可選的。留白或整個省略這個 key，分散式快取會改用行程內記憶體實作
    // （AddDistributedMemoryCache），Cache-Aside 的程式碼與行為不變，只是快取不跨執行個體共用。
    // 單一執行個體部署時這是正確設定；不填會在啟動時記一則警告，方便日後回溯
    "Redis": "localhost:6379"
  },

  "Jwt": {
    // 未設定會讓啟動失敗。至少 32 字元——HMAC-SHA256 簽章要求 256 bits 的金鑰，
    // 太短不會在啟動時報錯，而是等到第一次發 token 才失敗
    "SecretKey": "<至少32字元的隨機字串>",
    "Issuer": "TaiwanAgriPlatform",
    "Audience": "TaiwanAgriPlatformUsers",
    "ExpiresInDays": "7"
  },

  // 前端直接呼叫本 API 時的允許來源。兩個 key 都留白會拒絕所有跨來源請求，
  // 而且只在瀏覽器端現形、伺服器端沒有任何紀錄——所以非 Development 環境都留白會讓啟動直接失敗。
  // 若本服務只透過同源 proxy 對外，把 SameOriginOnly 設成 true 明講這件事，檢查才不會當成漏填。
  // 本機開發屬於後者：Vite dev server（http://localhost:5173）用 proxy 把 /api 轉成同源，
  // 不經過 CORS，所以 Development 兩個都不填也能跑，只會收到一則啟動警告。
  "Cors": {
    "AllowedOrigins": [ "https://your-frontend.example" ],
    "SameOriginOnly": false
  },

  // RabbitMQ 也是可選的。留白或整個省略，PriceUpdatedConsumer 就不會被註冊。
  // ⚠ 之所以做成可選：那支 consumer 在 StartAsync 裡建連線且不接例外，而
  // IHostedService.StartAsync 拋例外的語意是「整個 host 起不來」——主機填了但連不上時，
  // 整個服務會以 Unhandled exception 結束、HTTP 連接埠根本不會開，不是「少一個背景功能」。
  // 不註冊時快取失效改由 25 小時 TTL 兜底，服務功能完整
  "RabbitMQ": {
    "HostName": "localhost"
  },

  // 以下兩區都有程式碼內建預設值，不填即採用預設，要調整才寫進來。
  // 這裡列的就是各自的預設值（台北一市場、10 種民生蔬菜）
  "FoodSafety": {
    "TodayVeg": {
      "MarketCode": "109",
      "CropCodes": [ "LA2", "SE1", "SB1", "LH1", "FJ1", "FI1", "FB1", "LF1", "LD1", "SP1" ]
    }
  },
  "MarketQueryLimits": {
    "DisasterRecordLimit": 5000,
    "CropCodesMaxCount": 5,
    "WatchlistDeleteMaxCount": 50
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
