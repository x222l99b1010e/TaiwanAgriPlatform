<Project Sdk="Microsoft.NET.Sdk">

  <!--
    整合測試：用真的 SQL Server、走完整的 HTTP 管線（WebApplicationFactory 起整個後端）。
    跟 TaiwanAgri.Tests（單元測試，EF InMemory）分開成兩個專案：這一組要一台 SQL Server 才跑得起來，
    CI 另外起一個資料庫容器、分開一步跑；平常的 dotnet test TaiwanAgri.Tests 不受影響。
    怎麼在本機跑見 README「Step 8：執行測試」。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaiwanAgri.Web\TaiwanAgri.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
